# Goal
nav_msgs/OccupancyGrid map
bool use_cleanable_mask
oomwoo_segmentation_interfaces/MaskGrid cleanable_mask
bool include_diagnostics
---
# Result
uint8 STATUS_SUCCESS=0
uint8 STATUS_INVALID_REQUEST=1
uint8 STATUS_ALGORITHM_FAILED=2
uint8 STATUS_CANCELLED=3
uint8 status
string message
string implementation_id
string implementation_version
oomwoo_segmentation_interfaces/LabelGrid labels
oomwoo_segmentation_interfaces/Room[] rooms
# Detected wall segments in the map frame. Derived, non-authoritative data:
# the authoritative result remains the label grid. Providers that do not
# detect walls return an empty array.
oomwoo_segmentation_interfaces/WallSegment[] walls
oomwoo_segmentation_interfaces/DiagnosticImage[] diagnostics
---
# Feedback
string stage
float32 progress
